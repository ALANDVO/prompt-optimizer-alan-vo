# Server & Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEMO_MODE=true
SECRET_KEY=

# Database
DATABASE_URL=sqlite:///./data/prompt_optimizer.db

# LLM Configuration (Keys only server-side)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# OIDC / Keycloak Configuration (Production / Enterprise SSO)
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/prompt-optimizer
OIDC_CLIENT_ID=prompt-optimizer-client
OIDC_AUDIENCE=prompt-optimizer-api
